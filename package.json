{
	"name": "svelte-gui-system",
	"version": "0.1.0",
	"description": "Customizable web-based desktop interface library with audio, events, and floating windows",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"svelte": "./dist/index.js",
			"types": "./dist/types/index.d.ts"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "vite build && pnpm build:types && node scripts/finalize-types.js",
		"build:types": "tsc -p tsconfig.json",
		"check": "pnpm build:types",
		"clean": "rm -rf dist",
		"format": "prettier ./src --write"
	},
	"license": "ISC",
	"peerDependencies": {
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"typescript": "~7.0.2",
		"vite": "^8.3.4"
	}
}
