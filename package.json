    "@tauri-apps/cli": "^2.11.5",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
