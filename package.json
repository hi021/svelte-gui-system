{
	"name": "svelte-gui-system",
	"version": "0.1.0",
	"description": "Customizable web-based desktop interface library with audio, events, and floating windows",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"svelte": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "vite build && pnpm build:types",
		"build:types": "svelte-package --input src/lib --output dist/types --tsconfig ./tsconfig.package.json",
		"check": "pnpm check:source && pnpm build:types && pnpm check:consumer",
		"check:source": "svelte-check --tsconfig ./tsconfig.json",
		"check:consumer": "tsc --noEmit -p tests/consumer/tsconfig.json",
		"clean": "rm -rf dist",
		"format": "prettier ./src --write"
	},
	"license": "ISC",
	"peerDependencies": {
		"svelte": "^5.57.3"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
