{
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"module": "esnext",
		"moduleResolution": "Bundler",
		"outDir": "dist/types",
		"rootDir": "src/lib",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"verbatimModuleSyntax": true,
		"types": ["svelte"]
	},
	"include": ["src/lib/**/*.ts", "src/lib/**/*.d.ts"]
}
